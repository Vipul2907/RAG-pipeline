# RAG Pipeline Configuration
# Copy this file to .env and modify as needed

# Embedding settings
EMBEDDING_DIMENSION=384
EMBEDDING_PROVIDER=dummy  # Options: dummy, huggingface, openai

# HuggingFace embedding model (used when EMBEDDING_PROVIDER=huggingface)
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# OpenAI embedding model (used when EMBEDDING_PROVIDER=openai)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY=your-openai-api-key

# Chunking settings
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Index settings
INDEX_TYPE=hnsw  # Options: brute_force, hnsw
INDEX_PATH=./data/index

# Search settings
DEFAULT_TOP_K=10

# Hybrid Search (BM25 + Dense with RRF)
USE_HYBRID_SEARCH=false
BM25_WEIGHT=0.5
DENSE_WEIGHT=0.5
RRF_K=60

# Reranker (Cross-Encoder)
USE_RERANKER=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_K=50
RERANKER_BATCH_SIZE=32
# RERANKER_DEVICE=cuda  # or cpu, mps, auto

# Query Expansion
USE_HYDE=false
HYDE_LLM_PROVIDER=dummy  # anthropic, openai, groq, dummy
USE_MULTI_QUERY=false
MULTI_QUERY_VARIATIONS=3

# Filtered Search
FILTERED_SEARCH_MULTIPLIER=3.0

# LLM Provider settings
LLM_PROVIDER=anthropic  # Options: anthropic, openai, groq, dummy

# Anthropic LLM model (used when LLM_PROVIDER=anthropic)
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenAI LLM model (used when LLM_PROVIDER=openai)
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=your-openai-api-key

# Groq LLM model (used when LLM_PROVIDER=groq)
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=your-groq-api-key

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s