# RAG Pipeline Configuration
# Copy this file to .env and modify as needed

# Embedding settings
EMBEDDING_DIMENSION=384
EMBEDDING_PROVIDER=dummy  # Options: dummy

# Chunking settings
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Index settings
INDEX_TYPE=brute_force  # Options: brute_force, hnsw (future)
INDEX_PATH=./data/index

# Search settings
DEFAULT_TOP_K=10

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s